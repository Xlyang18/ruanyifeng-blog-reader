{
  "manifest_version": 3,
  "name": "阮一峰博客阅读助手",
  "version": "1.0.0",
  "description": "在阮一峰的网络日志上标注已读/未读，并在有新文章时主动提醒。",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.ruanyifeng.com/*",
    "https://feeds.feedburner.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ruanyifeng.com/blog/*",
        "https://www.ruanyifeng.com/blog/"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "阮一峰博客阅读助手",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}